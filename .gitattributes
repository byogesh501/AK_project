# Auto-detect text files and normalize to LF
* text=auto eol=lf

# Explicitly ensure LF for critical text files
*.py text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.sh text eol=lf

# Ignore binary files
*.pt binary
*.pth binary
*.onnx binary
*.jpg binary
*.jpeg binary
*.png binary
